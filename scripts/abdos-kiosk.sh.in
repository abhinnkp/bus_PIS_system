#!/usr/bin/env bash
set -euo pipefail

log() {
    logger -t abdos-kiosk "$1"
    echo "abdos-kiosk: $1"
}

# Allowed configuration keys API
ALLOWED_KEYS=(
    "URL" "HOSTNAME" "ETHERNET_PRIORITY" "WIFI_SSID" "WIFI_PASSWORD"
    "TIMEZONE" "SPLASH_IMAGE" "SSH_ENABLED" "WATCHDOG" "CURSOR" "CACHE_MODE"
)

is_allowed_key() {
    local k="$1"
    for allowed in "${ALLOWED_KEYS[@]}"; do
        [[ "$k" == "$allowed" ]] && return 0
    done
    return 1
}

# 1. Source configuration
CONFIG_FILE="/boot/firmware/abdos.conf"
if [[ -f "$CONFIG_FILE" ]]; then
    log "Loading configuration from $CONFIG_FILE"
    while IFS='=' read -r key value; do
        # Skip comments and empty lines early
        [[ "$key" =~ ^[[:space:]]*#.*$ ]] && continue
        [[ -z "${key// /}" ]] && continue

        # Remove leading/trailing whitespace
        key="${key#"${key%%[![:space:]]*}"}"
        key="${key%"${key##*[![:space:]]}"}"

        if [[ -n "${value+x}" ]]; then
            value="${value#"${value%%[![:space:]]*}"}"
            value="${value%"${value##*[![:space:]]}"}"

            value="${value#\"}"
            value="${value%\"}"
            value="${value#\'}"
            value="${value%\'}"
        else
            value=""
        fi

        if ! is_allowed_key "$key"; then
            log "WARNING: Unknown or malformed configuration key ignored: '$key'"
            continue
        fi

        export "$key=$value"
    done < "$CONFIG_FILE"
else
    log "WARNING: Configuration file not found at $CONFIG_FILE"
fi

# Ensure URL is set
TARGET_URL=${URL:-about:blank}
log "Target URL: $TARGET_URL"

# Cache Mode Logic
CACHE_MODE=${CACHE_MODE:-ram}
if [[ "${CACHE_MODE,,}" == "clear" ]]; then
    log "Clearing Chromium profile directory"
    rm -rf "@HOME@/.config/chromium/" || true
    rm -rf "@HOME@/.cache/chromium/" || true
fi

# Cursor Logic
SHOW_CURSOR=${CURSOR:-false}
if [[ "${SHOW_CURSOR,,}" == "false" ]]; then
    log "Hiding mouse cursor via unclutter"
    unclutter -idle 0.1 -root &
fi

# 2. X11 Display Settings
# Disable DPMS (Energy Star) features
xset -dpms
# Disable screen blanking
xset s noblank
# Disable screen saver
xset s off

# 3. Window Manager
# Start Openbox window manager in the background
openbox-session &
# Short synchronization delay to ensure the window manager is ready on slower hardware
sleep 1

# 4. Hardware Detection (ARMv6 / NEON limitation)
if [[ "$(uname -m)" == "armv6l" ]]; then
    log "ERROR: ARMv6 architecture (Raspberry Pi Zero W / 1) detected."
    log "ERROR: The modern Chromium browser on Bookworm requires NEON instructions, which ARMv6 lacks."
    log "ERROR: ABDOS cannot launch Chromium on this hardware. Halting kiosk startup to prevent crash loops."
    # Exit with code 2 to instruct systemd not to restart it
    exit 2
fi

# 5. Browser Launch Validation
CHROMIUM_BIN="@CHROMIUM_BIN@"
if [[ ! -x "$CHROMIUM_BIN" ]]; then
    log "ERROR: Chromium executable not found or not executable at: $CHROMIUM_BIN"
    log "ERROR: ABDOS cannot continue."
    exit 2
fi

# 6. Chromium Launch (Heavily optimized for Pi Zero/2/3)
log "Launching Chromium in kiosk mode"

# Use Chromium flags carefully selected for low memory footprint and long-term stability
CHROMIUM_FLAGS=(
    "--kiosk"                         # Fullscreen, locked down
    "--no-first-run"                  # Disable first run dialog
    "--noerrdialogs"                  # Suppress error dialogs
    "--disable-infobars"              # Disable infobars (translation, crash recovery)
    "--disable-features=TranslateUI"  # Ensure translation is disabled
    "--disable-dev-shm-usage"         # Fix crash on low /dev/shm memory by using /tmp
    "--user-data-dir=/tmp/chromium-user-data" # Move entire profile to RAM to ensure clean session
    "--disk-cache-dir=/tmp/chromium-cache"    # Move cache to RAM (tmpfs) to save SD card writes
    "--disable-gpu-shader-disk-cache" # Disable GPU shader disk cache
    "--disable-extensions"            # Disable extensions to save RAM
    "--disable-sync"                  # Disable Google Sync
    "--disable-pinch"                 # Prevent pinch-to-zoom on touchscreens
    "--overscroll-history-navigation=0" # Prevent swipe to go back
)
# Note: Removed obsolete flags --fast and --fast-start as they are no longer supported in modern Chromium versions.

# Start Chromium
# We execute it directly (exec replaces the shell process) so systemd can accurately monitor its PID.
exec @CHROMIUM_BIN@ "${CHROMIUM_FLAGS[@]}" "$TARGET_URL"
