#!/usr/bin/env bash
set -euo pipefail

log() {
    logger -t abdos-kiosk "$1"
    echo "abdos-kiosk: $1"
}

# Allowed configuration keys API
ALLOWED_KEYS=(
    "URL" "HOSTNAME" "ETHERNET_PRIORITY" "WIFI_SSID" "WIFI_PASSWORD"
    "TIMEZONE" "SPLASH_IMAGE" "SSH_ENABLED" "WATCHDOG" "CURSOR" "CACHE_MODE"
)

is_allowed_key() {
    local k="$1"
    for allowed in "${ALLOWED_KEYS[@]}"; do
        [[ "$k" == "$allowed" ]] && return 0
    done
    return 1
}

# 1. Source configuration
CONFIG_FILE="/boot/firmware/abdos.conf"
if [[ -f "$CONFIG_FILE" ]]; then
    log "Loading configuration from $CONFIG_FILE"
    while IFS='=' read -r key value; do
        # Skip comments and empty lines early
        [[ "$key" =~ ^[[:space:]]*#.*$ ]] && continue
        [[ -z "${key// /}" ]] && continue

        # Remove leading/trailing whitespace
        key="${key#"${key%%[![:space:]]*}"}"
        key="${key%"${key##*[![:space:]]}"}"

        if [[ -n "${value+x}" ]]; then
            value="${value#"${value%%[![:space:]]*}"}"
            value="${value%"${value##*[![:space:]]}"}"

            value="${value#\"}"
            value="${value%\"}"
            value="${value#\'}"
            value="${value%\'}"
        else
            value=""
        fi

        if ! is_allowed_key "$key"; then
            log "WARNING: Unknown or malformed configuration key ignored: '$key'"
            continue
        fi

        export "$key=$value"
    done < "$CONFIG_FILE"
else
    log "WARNING: Configuration file not found at $CONFIG_FILE"
fi

# Ensure URL is set
TARGET_URL=${URL:-about:blank}
log "Target URL: $TARGET_URL"

# Cache Mode Logic
CACHE_MODE=${CACHE_MODE:-ram}
if [[ "${CACHE_MODE,,}" == "clear" ]]; then
    log "Clearing Chromium profile directory"
    rm -rf "@HOME@/.config/chromium/" || true
    rm -rf "@HOME@/.cache/chromium/" || true
fi

# Cursor Logic
SHOW_CURSOR=${CURSOR:-false}
if [[ "${SHOW_CURSOR,,}" == "false" ]]; then
    log "Hiding mouse cursor via unclutter"
    unclutter -idle 0.1 -root &
fi

# 2. X11 Display Settings
# Disable DPMS (Energy Star) features
xset -dpms
# Disable screen blanking
xset s noblank
# Disable screen saver
xset s off

log "[Display] Display environment created: DISPLAY=$DISPLAY"

# 3. Validation: X Server Status
if ! xset q >/dev/null 2>&1; then
    log "[ERROR] X server is not available or responding."
    exit 2
fi
log "[Display] X server socket is available."

# 4. Window Manager
log "[Openbox] Starting Openbox..."
openbox-session &
# Wait for Openbox to register itself to avoid race conditions
for i in {1..5}; do
    if xprop -root _NET_SUPPORTING_WM_CHECK >/dev/null 2>&1; then
        log "[Openbox] Openbox started successfully."
        break
    fi
    sleep 1
    if [[ $i -eq 5 ]]; then
        log "[WARNING] Openbox startup verification timed out, proceeding anyway."
    fi
done

# 5. Hardware Detection (ARMv6 / NEON limitation)
if [[ "$(uname -m)" == "armv6l" ]]; then
    log "[ERROR] ARMv6 architecture (Raspberry Pi Zero W / 1) detected."
    log "[ERROR] The modern Chromium browser on Bookworm requires NEON instructions, which ARMv6 lacks."
    log "[ERROR] ABDOS cannot launch Chromium on this hardware. Halting kiosk startup to prevent crash loops."
    # Exit with code 2 to instruct systemd not to restart it
    exit 2
fi

# 6. Browser Launch Validation
CHROMIUM_BIN="@CHROMIUM_BIN@"
if [[ ! -x "$CHROMIUM_BIN" ]]; then
    log "[ERROR] Chromium executable not found or not executable at: $CHROMIUM_BIN"
    log "[ERROR] ABDOS cannot continue."
    exit 2
fi
log "[Chromium] Chromium binary validated at $CHROMIUM_BIN."

# 7. Chromium Launch (Heavily optimized for Pi Zero/2/3)
log "[Chromium] Launching Chromium in kiosk mode targeting $TARGET_URL"

# Chromium Flags Documentation:
# --kiosk: Enforces fullscreen mode and removes all window decorations/menus.
# --no-first-run: Skips the initial setup wizard, crucial for unattended appliances.
# --noerrdialogs: Suppresses error popups (e.g., "Chromium crashed unexpectedly"), forcing a clean UI.
# --disable-infobars: Hides yellow warning bars like "Google API keys are missing" or crash recovery prompts.
# --disable-features=Translate: Explicitly disables the translation popup feature to save RAM and screen space.
# --disable-dev-shm-usage: Crucial for low-RAM devices; forces Chromium to use /tmp instead of the tiny /dev/shm, preventing "Aw, Snap!" crashes.
# --user-data-dir=/tmp/...: Forces the entire user profile (history, cookies, preferences) into RAM, guaranteeing a perfectly clean session on every reboot and saving SD card writes.
# --disk-cache-dir=/tmp/...: Forces the web cache into RAM (tmpfs) to drastically reduce SD card wear during 24x7 operation.
# --disable-gpu-shader-disk-cache: Prevents Chromium from writing GPU shaders to the SD card, saving write cycles.
# --disable-extensions: Disables the extension subsystem entirely to conserve RAM.
# --disable-sync: Disables Google Sync subsystem to conserve RAM and CPU.
# --disable-pinch: Prevents pinch-to-zoom gestures if a touchscreen is connected.
# --overscroll-history-navigation=0: Disables swipe-to-go-back gestures, locking the user to the single page.
CHROMIUM_FLAGS=(
    "--kiosk"
    "--no-first-run"
    "--noerrdialogs"
    "--disable-infobars"
    "--disable-features=Translate"
    "--disable-dev-shm-usage"
    "--user-data-dir=/tmp/chromium-user-data"
    "--disk-cache-dir=/tmp/chromium-cache"
    "--disable-gpu-shader-disk-cache"
    "--disable-extensions"
    "--disable-sync"
    "--disable-pinch"
    "--overscroll-history-navigation=0"
)

# Start Chromium
# We execute it directly (exec replaces the shell process) so systemd can accurately monitor its PID.
exec @CHROMIUM_BIN@ "${CHROMIUM_FLAGS[@]}" "$TARGET_URL"
